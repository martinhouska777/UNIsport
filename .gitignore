# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Never commit a captured auth session
session-cookie.txt
scripts/landing/.chrome-profile/
scripts/landing/*.png
scripts/landing/*.html
scripts/landing/shots.json
scripts/landing/raw/

# The Vercel CLI's local project link (env files are already covered above).
.vercel

# Env files pulled down by the Vercel CLI (feed.env, dev.env, ...) hold DB passwords.
*.env

# Business research / strategy — NOT for the public repo
unisportforboathouses/

# rendered video (regenerate with scripts/video/*.mjs)
mockups/video/*.mp4

# varsity/coach captures carry the squad's REAL names — never into the public repo (SOCIAL.md 7B)
mockups/social/screens/*/varsity-*.png
mockups/social/screens/*/coach-*.png
mockups/social/phones/varsity-*.png
mockups/social/phones/coach-*.png
mockups/social/phones-sheet.png
mockups/video/sfx/
mockups/video/sfx-real/
mockups/video/sfx-soft/
