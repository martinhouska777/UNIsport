# Supabase — copy this file to ".env.local" and fill in the values.
# Find them in your Supabase dashboard: Project Settings (gear) -> API.
# (.env.local is gitignored — these never get committed.)

# Project URL, e.g. https://abcdxyz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / "public" key (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web Push (VAPID) — for real notifications. Generate a pair once with:
#   npx web-push generate-vapid-keys --json
# Public key is browser-safe; the private key is server-only (never expose it).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact URL the push service can reach you at, e.g. mailto:you@example.com
VAPID_SUBJECT=

# Claude vision, for the erg-monitor scan (POST /api/varsity/erg-scan). Server-side only;
# without it the scan answers 503 and the app falls back to typing the result in.
ANTHROPIC_API_KEY=

# The public site URL — used for absolute link-card (og:image) URLs.
# Leave EMPTY until the real domain is bought and pointed at Vercel; without it
# the app falls back to Vercel's own production URL, which is correct today.
# When unisportcampus.com is live, set this in the Vercel project settings:
#   NEXT_PUBLIC_SITE_URL=https://unisportcampus.com
NEXT_PUBLIC_SITE_URL=

# Google Drive — where crew videos are uploaded (db/varsity_videos.sql keeps the
# record of which boat each one is of; the file itself goes to the squad's own
# Drive folder). A browser app is a "public client", so there is NO client
# secret: this id is the whole configuration and is safe to expose.
#
# Get it at https://console.cloud.google.com -> APIs & Services:
#   1. Enable the "Google Drive API".
#   2. OAuth consent screen: External, add yourself under "Test users".
#   3. Credentials -> Create credentials -> OAuth client ID -> Web application.
#   4. Authorised JavaScript origins: http://localhost:3000 and the Vercel URLs.
# Leave EMPTY and video uploads fall back to the app's own (small) storage.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# The squad's Drive folder. Defaults to the Harvard team's "HUBC Footage 25-26"
# (lib/varsity/drive.ts) — set this only for a different school. It is the id
# out of the folder's own URL, not a secret.
NEXT_PUBLIC_DRIVE_FOLDER_ID=
